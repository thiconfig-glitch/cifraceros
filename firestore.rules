rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Músicas e Cifras: Todos podem ler; somente Administradores autenticados podem criar, editar e excluir
    match /repertorio/{songId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /repertorio_letras/{songId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Chat da Equipe: Todos podem ler e enviar mensagens; apenas Admin pode limpar/excluir
    match /letras_chat/{msgId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // 3. Estado do Culto (Setlists e Sincronização Teclado ⇄ Vocal em tempo real)
    match /app_state/{stateId} {
      allow read: if true;
      allow write: if true;
    }

    // Bloqueio preventivo padrão
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
